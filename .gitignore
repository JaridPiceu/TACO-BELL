# Julia
Manifest.toml
/docs/build/
*.jl.cov
*.jl.*.cov
*.jl.mem

# Raw TNRKit outputs — add these to db/ with add_data! (scripts/add_data.jl),
# don't commit the raw files themselves.
*.jld2
*.h5
# …except the small real TNRKit files the tests read (see test/fixtures/README.md)
!test/fixtures/*.jld2
# …except the database itself: compressed HDF5 shards (see src/storage.jl).
!db/shards/*.h5
# half-written shard (only exists if a write was interrupted)
db/shards/*.tmp

# Explorer webpage data: 100% derived from db/shards/ by export_web
# (scripts/update_web.jl), regenerated by the GitHub Pages workflow on every
# deploy, so never committed.
web/data/

# Editor / OS
.vscode/
.DS_Store
Thumbs.db
